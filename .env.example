# ==========================================
# ShareSphere Environment Configuration
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Default credentials for standard local MySQL / XAMPP / MySQL Workbench
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sharesphere

# JWT Authentication Secret
JWT_SECRET=sharesphere_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Optional Email / External Services (Leave blank for local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
